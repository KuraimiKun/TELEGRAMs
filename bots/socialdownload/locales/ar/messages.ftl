## SocialDownload — العربية (Arabic)

## ---------- Start / general ----------
start-welcome =
    👋 أهلاً بك، <b>{ $name }</b>!

    أنا بوت تحميل <b>الفيديوهات والصور والموسيقى</b> من تيك توك، إنستغرام، يوتيوب، إكس (تويتر)، فيسبوك، بينترست، ريديت، ثريدز، ساوند كلاود وأكثر من 1800 موقع آخر.

    📎 <b>فقط أرسل لي أي رابط!</b>
    🔎 أو اكتب أي نص للبحث في يوتيوب مباشرة.
start-referred = 🤝 انضممت عبر دعوة من صديق. أهلاً بك!

btn-help = ❓ مساعدة
btn-lang = 🌍 اللغة
btn-vip = 💎 اشتراك VIP
btn-profile = 👤 حسابي
btn-settings = ⚙️ الإعدادات
btn-add-group = ➕ إضافة لمجموعة
btn-referral = 🎁 VIP مجاني
btn-back = ⬅️ رجوع
btn-cancel = ✖️ إلغاء
btn-close = ✖️ إغلاق

help-text =
    ❓ <b>طريقة الاستخدام</b>

    1️⃣ انسخ الرابط من تيك توك، إنستغرام، يوتيوب، إكس، فيسبوك، بينترست، ساوند كلاود…
    2️⃣ أرسله للبوت هنا.
    3️⃣ استلم ملفك بأعلى دقة وبدون أي علامة مائية.

    <b>الأوامر</b>
    /start — القائمة الرئيسية
    /search — البحث عن فيديوهات يوتيوب
    /music — البحث عن الموسيقى وتحميلها
    /profile — حسابك وإحصائياتك
    /settings — الجودة الافتراضية، صيغة الصوت، الشروحات
    /vip — باقات VIP
    /referral — دعوة الأصدقاء للحصول على VIP مجاناً
    /lang — تغيير اللغة
    /terms — شروط الاستخدام
    /support — الدعم الفني

    💡 <b>تلميحات</b>
    • يمكنك استخدام البوت إنلاين في أي محادثة: اكتب <code>@{ $bot } الرابط</code>
    • أضفني إلى مجموعتك وسأقوم بتحميل الروابط تلقائياً.
    • الروابط المحملة مسبقاً تُرسل فوراً في ثوانٍ.

terms-text =
    📜 <b>شروط الاستخدام</b>

    • هذا البوت أداة لتحميل الوسائط العامة للاستخدام الشخصي فقط.
    • تقع على عاتقك مسؤولية احترام حقوق النشر وشروط المنصات التي تقوم بالتحميل منها.
    • يُمنع استخدام البوت لتحميل أو توزيع محتوى محظور أو مخالف.
    • إساءة الاستخدام أو الهجمات الآلية تؤدي للحظر الدائم.
    • اشتراكات VIP سلع رقمية وتُفعل فور إتمام الدفع.

support-text = 💬 الدعم الفني: { $contact }
support-none = 💬 لم يتم تحديد حساب دعم فني بعد.

lang-choose = 🌍 اختر لغتك المفضلة:
lang-changed = ✅ تم تغيير اللغة إلى العربية بنجاح.

## ---------- Generic states ----------
throttled = 🐢 تمهل قليلاً! الرجاء الانتظار بضع ثوانٍ بين الطلبات.
banned = 🚫 لقد تم حظرك من استخدام هذا البوت.
maintenance = 🛠 البوت يخضع لأعمال صيانة حالياً. يرجى المحاولة لاحقاً.
expired-menu = ⌛ انتهت صلاحية هذه القائمة، يرجى إعادة إرسال الرابط.
unknown = غير معروف
state-on = ✅ مفعل
state-off = ❌ معطل
saved = ✅ تم الحفظ بنجاح

## ---------- Download flow ----------
dl-analyzing = 🔎 جاري فحص الرابط…
dl-choose-format =
    🎬 <b>{ $title }</b>
    👤 { $uploader }  ⏱ { $duration }

    اختر الصيغة المطلوبة:
btn-best = ⭐ أفضل جودة
btn-audio = 🎵 صوت ({ $format })
dl-queued = ⏳ في قائمة الانتظار… دورك: <b>{ $position }</b>
dl-starting = ⚙️ جاري بدء التحميل…
dl-downloading =
    ⬇️ <b>جاري التحميل…</b> { $percent }%
    { $bar }
    { $done } / { $total } • { $speed }/ث • ⏱ { $eta }
dl-downloading-simple = ⬇️ <b>جاري التحميل…</b> { $done } • { $speed }/ث
dl-processing = 🛠 جاري المعالجة والتحويل…
dl-uploading = 📤 جاري الرفع إلى تيليجرام…
dl-cancelled = ❌ تم إلغاء التحميل.
dl-cancel-too-late = لقد اكتمل التحميل بالفعل.
dl-direct-link =
    📦 حجم الملف كبير جداً لتيليجرام ({ $size }).

    🔗 رابط التحميل المباشر (صالح لمدة { $minutes } دقيقة):
    { $link }
dl-caption-via = 📥 بواسطة @{ $bot }
dl-limit-reached =
    🚫 لقد وصلت للحد اليومي المجاني (<b>{ $limit }</b> تحميلة).

    ⏰ يتجدد الحد بعد { $hours }س { $minutes }د.
    💎 اشترك في VIP لتحميل غير محدود وأعلى سرعة!
dl-too-many-active = ⏳ لديك حالياً { $count } تحميلات قيد التنفيذ. يرجى الانتظار حتى تنتهي.
dl-platform-disabled = ⚠️ التحميل من هذه المنصة معطل مؤقتاً لأعمال الصيانة.
dl-quality-locked = 🔒 دقة { $quality } متاحة لمشتركي VIP فقط. اضغط على 💎 VIP للترقية.
dl-no-url = 🤔 أرسل لي رابطاً للتحميل، أو أي نص للبحث في يوتيوب.
dl-playlist =
    📃 قائمة تشغيل: <b>{ $title }</b>
    عدد العناصر: { $count }

    خطتك تسمح بتحميل حتى { $max } عناصر. ماذا تريد أن تفعل؟
btn-pl-video = 🎬 تحميل أول { $n } كفيديو
btn-pl-audio = 🎵 تحميل أول { $n } كصوت

## ---------- Errors ----------
error-private = 🔒 هذا المحتوى خاص أو مقتصر على المتابعين فقط.
error-login = 🔐 تتطلب المنصة تسجيل الدخول للوصول إلى هذا المحتوى. يرجى المحاولة لاحقاً.
error-geo = 🌍 هذا المحتوى محظور جغرافياً في بلد الخادم.
error-live = 🔴 البثوث المباشرة لا يمكن تحميلها أثناء البث. حاول بعد انتهاء البث.
error-too_large = 📦 حجم هذا الملف يتجاوز الحد المسموح في باقتك. باقة VIP تدعم أحجاماً أكبر حتى 2GB.
error-too_long = ⏱ مدة هذا الفيديو تتجاوز الحد المسموح في باقتك.
error-rate_limited = 🚦 المنصة تقيد الطلبات مؤقتاً بسبب الضغط. حاول بعد دقيقة.
error-removed = 🗑 تم حذف هذا المحتوى أو أن الرابط غير صحيح.
error-no_media = 🤷 لم يتم العثور على وسائط قابلة للتحميل في هذا الرابط.
error-unsupported = ❔ هذا الرابط غير مدعوم حالياً.
error-timeout = ⌛ استغرق التحميل وقتاً طويلاً وتوقف. يرجى المحاولة مجدداً.
error-upload = 📤 تعذر رفع الملف إلى تيليجرام. يرجى اختيار جودة أخرى.
error-unknown = 😕 حدث خطأ غير متوقع. يرجى المحاولة لاحقاً.
error-busy = 🧯 الخادم مشغول حالياً. يرجى المحاولة بعد بضع دقائق.
error-queue_expired = ⌛ انتظر طلبك طويلاً في الطابور وتم إلغاؤه. يرجى إرسال الرابط مجدداً.
not-your-menu = 🙅 هذه القائمة تخص مستخدماً آخر.

