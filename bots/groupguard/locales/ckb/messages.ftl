gg-help-family-title-discovery = ڕێنمایی و دەستکاری ناوەڕۆک
gg-help-family-moderation = <b>بەڕێوەبردن</b> · وەڵام، ID ی ژمارە یان @بەکارهێنەری پشکنراو. /ban 20 هۆکار؛ /tban 20 60s هۆکار؛ /mute 20؛ /tmute 20 2h هۆکار. ماوەی کاتی:60 چرکە–365 ڕۆژ. /kickme تەنها تۆ دەردەکات. جۆری d پەیامی وەڵام سڕدەکاتەوە؛ s فەرمان/وەڵام سڕدەکاتەوە و مافی سڕینەوە دەوێت. بەڕێوەبەران پارێزراون. /setwarnlimit 3؛ /setwarnmode ban؛ /setwarntime 1d. گرووپی نوێ سێ ئاگادارکردنەوە؛ ڕێکخستنی کۆن دەمێنێت. /approve تەنها پاراستنی ئاسایی ناوەڕۆک/زۆری پەیام تێدەپەڕێنێت، نە فەدراسیۆن/CAS/هاتنەژووری بەکۆمەڵ/کرداری دەستی. /promote لە مافی هاوبەشی داواکار و بۆت زیاتر نادات. پاککردنەوەی گشتی دروستکەر دەوێت.
gg-help-family-messages = <b>پەیام</b> · /del وەڵامی ڕاستەقینەی گرووپ دەوێت. /purge لەوێ دەستپێدەکات؛ /purgefrom و /purgeto سنوور پاشەکەوت دەکەن. سنووری دیاریکراو و ڕێسای Telegram کاردەکەن؛ پەسەندکردنی کۆمەڵ ژمارەی وردی سڕینەوە نییە. /pin [loud]، /permapin، /unpin، /unpinall مافی جێگیرکردن دەوێن؛ لابردنی هەمووی دروستکەر دەوێت. /antichannelpin و /cleanlinked پەیامی خۆکاری کەناڵی بەستراو کۆنترۆڵ دەکەن.
gg-help-family-logging = <b>تۆمار</b> · /setlog -100… مافی بەڕێوەبردنی ئێستای ئامانج و بڵاوکردنەوەی بۆت دەوێت. ڕێکخستنی نێردراوە دەبێت بنەڕەتی ڕاستەقینە وەرگیراوی هەبێت. /logcategories:settings/admin/user/automated/reports/other؛ /log و /nolog پۆل هەڵدەبژێرن. هەڵەی ناردن دیار دەمێنێت و سەرکەوتنی کردار ناسەلمێنێت.
gg-help-family-settings = <b>ڕێکخستن</b> · /settings پانێڵی کەسی کاتدار دەکاتەوە و مافی ئێستای گۆڕینی زانیاری دەپشکنێت. /setlang کۆد زمانی گرووپ؛ /lang بە تایبەت زمانی خۆت پاشەکەوت دەکات. /night 23 7 +3 لە شەو دادەخات؛ /night off تەنها دۆخی مافی خۆی کە هێشتا دەگونجێت دەگەڕێنێتەوە. گۆڕانی دەرەکی پێشەنگە.
gg-help-family-content = <b>دەستکاری</b> · /save وشە دەق یان وەڵام بە میدیا؛ /get وشە، #وشە، /notes تێبینی دەخوێننەوە. ناوی نوێ یەک وشەیە؛ ناوی کۆنی فراوان دەمێنێت. /filter "دەستەواژە" دەق، /filterprefix، /filterexact گونجان هەڵدەبژێرن؛ /stop کلیل لادەبات. /clearall و /stopall پەسەندکردنی دروستکەر دەوێن. شێوازی Rose:ئەستوور/لار/هێڵی خوار/هێڵی سەر/کۆد، بەستەر، وتە و هەڵبژاردەی هەڕەمەکی %%%. خانەکان:{ "{" }first{ "}" }, { "{" }last{ "}" }, { "{" }fullname{ "}" }, { "{" }username{ "}" }, { "{" }mention{ "}" }, { "{" }id{ "}" }, { "{" }chatname{ "}" }, { "{" }count{ "}" }. /button دوگمەی URL/تێبینی/ڕێسا دروست دەکات. گشتی preview/nonotif/protect/mediaspoiler؛ تێبینی admin/private/noprivate/repeat؛ پاڵاوتن user/allow_bot/replytag/command. /save وشە سڵاو { "{" }repeat 5m{ "}" } تەنها ناوەڕۆکی گشتی بە مافی ئێستای نووسەر پلان دەکات. ڕێسا، بەخێرهاتن و ناوەڕۆکی تایبەت هەمان پیشاندان بەکاردهێنن. ID ی میدیا هی بۆتە.
gg-help-family-captcha = <b>پشکنین</b> · /captcha on/off؛ /captchamode off/button/math/text/text2؛ /setcaptchatext؛ /captcharules on؛ /captchakick on/off؛ /captchakicktime و /captchamutetime ماوەی سنووردار دادەنێن. پشکنینی دەرکراو نەوە/کات دەهێڵێتەوە. داواکاری invite-users؛ بێدەنگکردن restrict-members دەوێت. وەڵام کەسی و یەکجارە. قەدەغەی فەدراسیۆن پێش پەسەندکردن/CAPTCHA.
gg-help-family-locks = <b>قەدەغە</b> · /lock links [کردار]، /unlock جۆر؛ /locktypes جۆری ڕاستەقینە؛ /locks دۆخ پیشان دەدات. /lockwarns ئاگادارکردنەوە کۆنترۆڵ دەکات. /allowlist:دۆمەین/ڕێڕەو، بانگهێشتی ورد، @چات یان stickerpack:/forward:/inline:/channel:/chat:/bot:/command:. نەخشەی نادروست ڕەت دەکرێتەوە. بەدەر تەنها ناوەڕۆکی گونجاوە؛ خۆکاری بێدەنگ دروستکەر و تۆماری ڕێپێدراو دەوێت.
gg-help-family-blocklists = <b>لیستی قەدەغە</b> · /addblocklist "دەستەواژە" دەق/پێشگر/ورد و ناسنامەی دیار بە هۆکار/کرداری هەڵبژاردە پشتگیری دەکات. /rmblocklist کلیلی وردی هەڵبژێردراو لادەبات. /blocklistmode nothing/warn/kick/ban/tban/mute/tmute کردار هەڵدەبژێرێت؛ کاتی ماوە دەوێت. /blocklistdelete سڕینەوە جیا کۆنترۆڵ دەکات. ئاڵۆزی نەخشە سنووردارە؛ تۆماری نادروست و تێپەڕاندنی سنوور ڕەت دەکرێنەوە.
gg-help-family-antispam = <b>زۆری پەیام و هاتنەژووری بەکۆمەڵ</b> · /setflood ژمارە بۆ پەیامی پێکەوە؛ /setfloodtimer ژمارە ماوە بۆ پەنجەرەی کات؛ /setfloodmode سزا/ماوە؛ /clearflood پاککردنەوەی زنجیرە دادەنێن. ڕێکخستنی کۆن دەمێنێت. /flood و /antiflood سیاسەت پیشان دەدەن؛ ناوی جێگرەوە بڕیاری ناوخۆی گونجانە. /antiraid on/off/duration، /raidtime، /raidactiontime، /autoantiraid ماوە و سزای جیای نوێهاتوو دەهێڵنەوە. پێش پەسەندکردن/CAPTCHA؛ ماوەی نەوەدار دوای دەستپێکردنەوە دەمێنێت.
gg-help-family-connections = <b>بەستن</b> · /connect groupID یان بەستەری کەسی. ئەندامێتی تۆ و بۆت پشکنین دەکرێت؛ گۆڕان هێشتا مافی وردی ئێستا دەوێت. /connection هەڵبژاردە پیشان دەدات، /disconnect لادەبات، /connect مێژووی بەردەوام پیشان دەدات. بەستن خاوەندارێتی فەدراسیۆن یان مافی بەڕێوەبەری بۆت نادات.
gg-help-family-identity = <b>زانیاری</b> · /id ID ی ڕاستەقینەی بەکارهێنەر/چات/سەرچاوە؛ /info ئامانجی ئێستا پیشان دەدات. وەڵام و @ناو بەڵگەی ئێستای ئەم بۆتە دەوێت. پەیامی نەناسراوی گرووپ مرۆڤ ناناسێنێت؛ ID ی مرۆڤ دروست ناکرێت.
gg-help-family-policy = <b>سیاسەت</b> · /disable فەرمان، /enable فەرمان، /disabled، /disableable ناوی بنەڕەت و جێگرەوە بەکاردهێنن. /disableadmin بەدەری بەڕێوەبەران؛ /disabledel سڕینەوە کۆنترۆڵ دەکات. فەرمانی گەڕاندنەوە بەردەست دەمێنێت. /bot2bot off/admin/all ئەندامێتی ڕاستەقینە دەپشکنێت؛ گۆڕان بە بنەڕەت پشکنینی مرۆڤ دەوێت. /bot2botskipreview تەنها دروستکەر. /silentactions ڕەزامەندی و تۆماری ڕێپێدراو دەوێت. runs/saved ی نادیار ڕوونکردنەوە دەدەن.
gg-help-family-cleanup = <b>پاککردنەوە</b> · /cleancommand admin/user/other و /keepcommand فەرمان هەڵدەبژێرن. /cleanmsg action/filter/note و /keepmsg تەنها پەیامی ڕاستەقینەی نێردراوی ئەم بۆتە؛ بەڵگە و ئەرکی پێنج خولەک ڕێگە لە خەماڵاندنی ID دەگرن. /cleanservice و /nocleanservice:join/leave/other/photo/pin/title/videochat. کاری بنەڕەت و پارەدانی دروست پێش پاککردنەوەن.
gg-help-family-topics = <b>بابەت</b> · /newtopic ناو، /renametopic ناو، /closetopic، /reopentopic لە بابەتی ڕاستەقینەی ئێستا کاردەکەن. /deletetopic پەسەندکردنی دروستکەر دەوێت؛ /setactiontopic ئامانجی هەمان گرووپ هەڵدەبژێرێت. مەکۆی Telegram و manage-topics پێویستن. بابەتی نەبوو/ناپشتگیریکراو هەڵەی ڕاستەقینە دەدات.
gg-help-family-utilities = <b>ئامراز</b> · /echo و /say ناوەڕۆکی ڕاستەوخۆ/وەڵام بە پیشاندانی هاوبەشی سنووردار دەنێرن. /broadcast تەنها بەڕێوەبەری دیاریکراوی بۆت یان خاوەنی ڕاستەقینەی لق؛ تەنها گرووپی ڕێکخراوی ئەم بۆتە. ئەنجامی ئامانج ناردنی بەشەکی/نادیار دەهێڵێتەوە؛ دۆخ و هەڵوەشاندنەوە هاوپێچی سەرکەوتوو دووبارە ناکەنەوە.
gg-help-family-federations = <b>فەدراسیۆن</b> · /newfed ناو UUID لەم بۆتە دروست دەکات. فەرمانی تایبەت فەدراسیۆنی خۆت بەکاردهێنێت بێ پەیوەندی بە بەستن؛ خوێندنەوەی UUID ڕۆڵ نادات. /fedpromote و /feddemote بەڕێوەبەر کۆنترۆڵ دەکەن؛ /feddemoteme ڕۆڵ جێدەهێڵێت. /joinfed UUID و /leavefed دروستکەری ئێستای گرووپ دەوێن. سڕینەوە قەدەغەی Telegram لانا‌بات. /fban userID هۆکار و /unfban userID خاوەن/بەڕێوەبەری فەدراسیۆن؛ /fedreason، /fednotif، /setfedlog خاوەن دەوێن. /quietfed تەنها ڕوونکردنەوەی پاسڤ دەشارێتەوە. /subfed UUID ئاڕاستەدار، سنووردار و بێ بازنەیە. /fedstat [userID]، /fbanstat UUID سەرچاوە/دۆخ پیشان دەدەن. /fbanlist csv/minicsv/json تەنها خاوەن بە ماوەی هاوبەشی 30 خولەک؛ /importfbans وەڵامی CSV ی سنووردار یان JSON ی ڕاستەقینەی هێڵیە و ڕیزی JSON ی خۆی بە ڕوونی پشتگیری دەکات. تەنها بەکارهێنەری بینراو پشکنین دەکرێت؛ لیستی تەواوی ئەندام بانگەشە ناکرێت.
gg-help-family-portability = <b>فایل و پاراستنی زانیاری</b> · /export all یان مۆدیول بەڕێوەبەر دەوێت؛ /import و /reset دروستکەری مرۆڤی ئێستا بە پەسەندکردنی کەسی یەکجاری پێنج خولەک دەوێن. ماوەی ناوخۆ پێنج خولەک؛ JSON ی وەشان‌داری خۆی، زۆرترین 2MiB و سنووری ناوەڕۆکی دیاریکراو. مۆدیول:moderation protections captcha flood raid night locks blocklists rules notes filters greetings policy language destinations extensions. مۆدیولی هەڵنەبژێردراو دەمێنێت. متمانە، پشکنین/ئەرکی دەرکراو، بەشداری، ڕۆڵ و قەدەغەی چالاک هاوردە ناکرێن. /privacy policy/data/delete تەنها چاتی کەسی خۆت بە لاپەڕە و کەمترین هەڵگرتنی پاراستن. هاوگونجێنەری پشکنراو بۆ هەناردەی تەواوی Rose نییە.
gg-help-family-discovery = <b>ڕێنمایی</b> · /help بەش پیشان دەدات؛ /help فەرمان ناو/جێگرەوە دەگەڕێت؛ /help بەش 2 بەردەوامە. /button یارمەتی نیشانەی دوگمە دەدات. هەر ڕێنمایی چوارچێوە، ماف، بنەڕەت و سنوور ڕوون دەکاتەوە. /settings پانێڵی کەسی گرووپ دەکاتەوە.
gg-data-error-cache_pending = داتای SQL ی هەڵبژاردە سڕایەوە. پاککردنەوەی کاشی نابەردەست لە ڕیزە؛ تۆماری پاراستنی چالاک دەمێنێت.
