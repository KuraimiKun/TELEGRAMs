gg-fed-intent-saved = המדיניות נשמרה; יעדים שנצפו הוכנסו לתור. הרשאות נוכחיות ומקורות הגבלה אחרים נבדקים לפני השפעות.
    חבר: { $user }
    גרסה: { $version }
gg-fed-subscriptions = מנויים ישירים לחסימות פדרציה:
    { $rows }
gg-fed-imported = הרשומות נבדקו ונשמרו; כפילויות זהות דולגו. אכיפה ביעדים שנצפו בתור.
    מספר: { $count }
    כפילויות זהות: { $duplicates }
gg-fed-event-import = חסימות שנבדקו יובאו; האכיפה בתור
gg-fed-error-file-format = השיבו ל־CSV ב־UTF-8 עם id/reason, ל־JSONL/NDJSON עם user_id או לייצוא מערך JSON של הבוט הזה. שורה לא תקפה מונעת את כל הכתיבות.
gg-fed-error-file-limit = לכל היותר 2 MiB ו־1000 רשומות. קבצים חסרים או גדולים מדי נדחים; רשימות אינן נחתכות בשקט.
gg-fed-error-file-duplicate = רשומות סותרות לאותו מזהה משתמש. לא יובאו חסימות.
gg-fed-error-file-rate = ייבוא וייצוא חולקים מרווח של 30 דקות לפדרציה. נסו מאוחר יותר.
gg-fed-error-reason = סיבות חסימה מוגבלות ל־1024 תווים וללא תווי בקרה שאינם נתמכים.
gg-fed-error-reason_required = הפדרציה דורשת סיבה שאינה ריקה לכל חסימה.
gg-fed-error-cycle = פדרציה אינה יכולה להירשם לעצמה או ליצור מחזור מכוון.
gg-fed-error-graph_limit = הושגה מכסה:32 יעדים ישירים,128 פדרציות נגישות,עומק16 או10 000 קשרים בבוט הזה.
gg-data-confirm = אשרו בתוך חמש דקות. היוצר הנוכחי וגרסת הקבוצה נבדקים שוב. רק מודולים שנבחרו משתנים; זהות, אמון וחסימות פעילות נשארים.
    SHA-256: { $digest }
    קבוצה: { $group }
    מודולים: { $modules }
    פעולה: { $operation }
gg-data-import = ייבוא מודולים של הקבוצה
gg-data-reset = איפוס מודולים של הקבוצה
gg-data-privacy-delete = מחיקת נתונים אישיים אופציונליים של הבוט הזה
gg-data-confirm-button = אישור השינוי
gg-data-personal = פתחו את האישור בצ׳אט הפרטי שלכם.
gg-data-saved = המודולים שנבחרו נשמרו.
gg-data-error-authority = ייבוא ואיפוס דורשים את יוצר הקבוצה המזוהה הנוכחי. ייצוא דורש מנהל נוכחי.
gg-data-error-format = השיבו ל־JSON תקף ועם גרסה של Group Guard שנוצר ב־/export.
gg-data-error-limit = הקובץ חורג ממכסת הגודל או התוכן שהוגדרה.
gg-data-error-version = סכמה או גרסה אינן נתמכות; לא הוחלו שינויים.
gg-data-error-module = בחרו מודולים מוכרים:/export all או /export notes rules. ייבוא ואיפוס משתמשים באותם שמות.
gg-data-error-field = שדות מודול לא תקפים או חסרים. הגדרות לא הוחלו.
gg-data-error-item = תוכן, אפשרויות או גישת חזרה אינם תקפים. תוכן לא נשמר.
gg-data-error-media = המדיה צריכה להיות מועלת לבוט הזה ונגישה דרך getFile. מזהי קבצים של בוטים אחרים אינם נתמכים.
gg-data-error-destination = יעדי יומן ונושאים דורשים הרשאות נוכחיות ויכולות של הבוט. מזהי נושא תקפים רק באותה קבוצה.
gg-data-error-language = בחרו שפה מותקנת עם /setlang.
gg-data-error-stale = האישור פג, השתנה או נוצל. התחילו מחדש.
gg-data-error-restore = לא ניתן לשחזר בבטחה הגבלות זמניות בבעלות הבוט. הראיות נשמרות; בדקו את הרשאות הבוט.
gg-data-error-rate = פעולות נתונים של קבוצה משתמשות במרווח מקומי של חמש דקות. נסו מאוחר יותר.
gg-data-error-delivery = האישור הפרטי לא נמסר. פתחו שיחה פרטית עם הבוט ונסו שוב.
gg-data-error-saved_delivery = ההגדרות נשמרו, אך הצעות הפקודות לא עודכנו. בדקו את הרשאות הבוט.
gg-privacy-policy = <b>הנתונים שלכם ב־Group Guard הזה</b>
    /privacy data מייצא חיבורים, פרופילים שנצפו, אזהרות, אישורים, מצב הגבלות/אימותים, בעלות/תפקידים/חסימות בפדרציה ומשימות אבטחה. תוכן פרטי של אחרים, תשובות אימות, פרטי אימות גישה וקבצים גולמיים אינם נכללים. השתמשו בפקודת ההמשך.
    /privacy delete מסיר היסטוריית חיבורים אופציונלית, שם/שם משתמש שנצפו, אימותים לא פעילים ותוכן קמפיינים שלכם שהסתיימו בבוט הזה. אזהרות/הגבלות פעילות, גרסאות חסימה, תפקידים, בעלות, מנויים, הגנה מחזרה ועבודת API לא ודאית שומרים מזהים מינימליים לאבטחה ולסדר. השתמשו בפקודות מפורשות לעזיבת/מחיקת פדרציה לקשרים האלה. פרופיל הפלטפורמה המשותף ובוטים אחרים נשארים.
    מפעילים מנהלים גיבויים וביקורת בנפרד. הפקודה אינה מוחקת הודעות Telegram חיצוניות או גיבויים ואינה מבטיחה תקופת שמירה אוטומטית.
gg-privacy-usage = /privacy policy · /privacy data [המשך] · /privacy delete — רק בצ׳אט הפרטי שלכם עם הבוט הזה.
gg-privacy-private = נדרש הצ׳אט הפרטי של האדם המבקש. סמנים לא תקפים אינם נותנים גישה לנתוני אחרים.
gg-privacy-next = דף הנתונים הבא:/privacy data { $cursor }
gg-privacy-deleted = נתונים אישיים אופציונליים של הבוט הזה הוסרו. אבטחה פעילה, בעלות ומשימות לא ודאיות שומרות מזהים מינימליים; ראו /privacy policy.
gg-language-usage = בחרו שפת קבוצה עם /setlang. /lang בפרטי משנה את שפת הפלטפורמה האישית. הקודים הזמינים למטה.
    קודי שפה: { $codes }
gg-language-saved = שפת תשובות הקבוצה שונתה.
gg-help-index = <b>מדריך פקודות Group Guard</b>
    /help תחום · /help פקודה · /help תחום 2. הפקודות המצוינות פועלות גם דרך /connect מאומת; תשובות פרטיות נשארות בצ׳אט הפרטי האמיתי.
    הגדרות דורשות שינוי מידע, סנקציות הגבלת חברים, מחיקה הרשאת מחיקה, הצמדה הרשאת הצמדה, מינויים הרשאת מינוי מנהלים ונושאים הרשאת ניהול נושאים. הרשאות הבוט נבדקות בנפרד. פעולות בעלים דורשות יוצר אנושי נוכחי. /settings פותח את לוח הקבוצה האישי.
gg-help-search = <b>פקודות תואמות</b>
    חיפוש: { $query }
gg-help-connected = קבוצה או חיבור מאומת; ההרשאות בתחום
gg-help-group-only = נדרשת הודעת קבוצה אמיתית
gg-help-unsupported = שם קטלוג נשמר; התנהגות לא מוגדרת מחזירה הסבר
gg-help-next = דף הבא
gg-help-previous = דף קודם
gg-help-family-title-moderation = ניהול ואישורים
gg-help-family-title-messages = מחיקה והצמדת הודעות
gg-help-family-title-logging = יומנים מורשים
gg-help-family-title-settings = הגדרות ושפת קבוצה
gg-help-family-title-content = הערות, מסננים, כללים וברכות
gg-help-family-title-captcha = אימות חברים חדשים
gg-help-family-title-locks = חסימות תוכן וחריגים
gg-help-family-title-blocklists = התאמות ופעולות ברשימת חסימה
gg-help-family-title-antispam = הגנה מהצפת הודעות והצטרפות המונית
gg-help-family-title-connections = חיבורים פרטיים לקבוצות
gg-help-family-title-identity = מידע על משתמשים וצ׳אטים
gg-help-family-title-policy = מדיניות פקודות ובוטים
gg-help-family-title-cleanup = ניקוי פקודות, בוטים ושירותים
gg-help-family-title-topics = נושאי פורום
gg-help-family-title-utilities = שליחת תוכן וקמפיינים של מפעיל
gg-help-family-title-federations = תפקידים, חסימות ומנויים בפדרציה
gg-help-family-title-portability = קובצי קבוצה ונתונים אישיים
gg-help-family-title-discovery = עזרה ועורך תוכן
gg-help-family-moderation = <b>ניהול</b> · תשובה, מזהה מספרי או @משתמש מאומת. /ban 20 סיבה; /tban 20 60s סיבה; /mute 20; /tmute 20 2h סיבה. זמני:60 שניות–365 ימים. /kickme מסיר רק אתכם. גרסאות d מוחקות את הודעת התשובה; s את הפקודה/תשובה ודורשות הרשאת מחיקה. מנהלים מוגנים. /setwarnlimit 3; /setwarnmode ban; /setwarntime 1d. בקבוצות חדשות שלוש אזהרות; הגדרות ישנות נשארות. /approve פוטר רק מהגנה רגילה של תוכן/הצפה, לא מפדרציה/CAS/כניסה המונית/פעולה ידנית. /promote אינו חורג מההרשאות המשותפות למבקש ולבוט. איפוס כולל דורש את היוצר.
gg-help-family-messages = <b>הודעות</b> · /del דורש תשובה אמיתית בקבוצה. /purge מתחיל שם; /purgefrom ו־/purgeto שומרים גבולות. המכסות המוגדרות וכללי Telegram חלים; אישור חבילה אינו מספר מדויק של מחיקות. /pin [loud], /permapin, /unpin, /unpinall דורשים הצמדה; הסרת כל ההצמדות דורשת יוצר. /antichannelpin ו־/cleanlinked מנהלים הודעות אוטומטיות מהערוץ המחובר.
gg-help-family-logging = <b>יומנים</b> · /setlog -100… דורש ניהול נוכחי ביעד והרשאת פרסום לבוט. הגדרה מועברת חייבת להתאים למקור שבאמת התקבל. /logcategories:settings/admin/user/automated/reports/other; /log ו־/nolog בוחרים קטגוריות. כשלי מסירה נשארים גלויים ואינם מוכיחים הצלחה של פעולה.
gg-help-family-settings = <b>הגדרות</b> · /settings פותח לוח אישי עם תפוגה ובדיקה נוכחית של שינוי מידע. /setlang קוד שומר שפת קבוצה; /lang בפרטי שפה אישית. /night 23 7 +3 סוגר בלילה; /night off משחזר רק מצב הרשאות בבעלות הבוט שעדיין תואם. לשינויים חיצוניים קדימות.
gg-help-family-content = <b>עורך</b> · /save מילה טקסט או תשובה למדיה; /get מילה, #מילה, /notes קוראים הערות. שמות חדשים הם מילה אחת; שמות ישנים רחבים נשמרים. /filter "ביטוי" טקסט, /filterprefix, /filterexact בוחרים התאמה; /stop מסיר מפתח. /clearall ו־/stopall דורשים אישור יוצר. עיצוב Rose:מודגש/נטוי/קו תחתי/קו חוצה/קוד, קישורים, ציטוטים וחלופות אקראיות %%%. שדות:{ "{" }first{ "}" }, { "{" }last{ "}" }, { "{" }fullname{ "}" }, { "{" }username{ "}" }, { "{" }mention{ "}" }, { "{" }id{ "}" }, { "{" }chatname{ "}" }, { "{" }count{ "}" }. /button יוצר כפתורי URL/הערה/כללים. אפשרויות כלליות preview/nonotif/protect/mediaspoiler; הערות admin/private/noprivate/repeat; מסננים user/allow_bot/replytag/command. /save מילה שלום { "{" }repeat 5m{ "}" } מתזמן רק תוכן ציבורי עם הרשאות המחבר הנוכחיות. כללים, ברכות ותוכן פרטי חולקים מציג. מזהי מדיה שייכים לבוט.
gg-help-family-captcha = <b>אימות</b> · /captcha on/off; /captchamode off/button/math/text/text2; /setcaptchatext; /captcharules on; /captchakick on/off; /captchakicktime ו־/captchamutetime קובעים זמנים מוגבלים. אתגרים שהונפקו שומרים דור/מועד. בקשות דורשות invite-users; השתקה restrict-members. תשובות אישיות וחד־פעמיות. חסימות פדרציה קודמות לאישור/CAPTCHA.
gg-help-family-locks = <b>חסימות</b> · /lock links [פעולה], /unlock סוג; /locktypes מציג סוגים אמיתיים, /locks מצב. /lockwarns מנהל אזהרות. /allowlist:תחום/נתיב, הזמנה מדויקת, @צ׳אט או stickerpack:/forward:/inline:/channel:/chat:/bot:/command:. דפוסים לא תקפים נדחים. חריגים חלים רק על תוכן תואם; אוטומציה שקטה דורשת יוצר ויומן מורשה.
gg-help-family-blocklists = <b>רשימת חסימה</b> · /addblocklist "ביטוי" תומך בטקסט/קידומת/מדויק ובזהויות מוצהרות עם סיבה/פעולה אופציונליות. /rmblocklist מסיר מפתחות שנבחרו בדיוק. /blocklistmode nothing/warn/kick/ban/tban/mute/tmute בוחר פעולה; מצב זמני דורש משך. /blocklistdelete מנהל מחיקה בנפרד. מורכבות דפוסים מוגבלת; רשומות לא תקפות וחריגות נדחות.
gg-help-family-antispam = <b>הצפה וכניסה המונית</b> · /setflood מספר להודעות רצופות; /setfloodtimer מספר משך לחלון זמן; /setfloodmode עונש/משך; /clearflood לניקוי רצף. הגדרות ישנות נשמרות. /flood ו־/antiflood מציגים מדיניות; השם החלופי הוא החלטת תאימות מקומית. /antiraid on/off/duration, /raidtime, /raidactiontime, /autoantiraid שומרים תקופה ועונש נפרד למצטרפים. קדימות לאישור/CAPTCHA; תפוגה לפי דור שורדת הפעלה מחדש.
gg-help-family-connections = <b>חיבורים</b> · /connect groupID או קישור אישי. החברות שלכם ושל הבוט נבדקות; שינויים עדיין דורשים הרשאות נוכחיות מדויקות. /connection מציג בחירה, /disconnect מסיר, /connect מציג היסטוריה עם המשך. חיבור אינו נותן בעלות פדרציה או הרשאת מפעיל.
gg-help-family-identity = <b>מידע</b> · /id מציג מזהי משתמש/צ׳אט/מקור אמיתיים; /info את היעד הנוכחי. תשובות ו־@שמות דורשים ראיות נוכחיות של הבוט הזה. הודעת קבוצה אנונימית אינה מזהה אדם; לא מומצא מזהה אנושי.
gg-help-family-policy = <b>מדיניות</b> · /disable פקודה, /enable פקודה, /disabled, /disableable משתמשים בשמות קנוניים וחלופיים. /disableadmin מנהל חריגי מנהלים; /disabledel מחיקה. פקודות שחזור נשארות נגישות. /bot2bot off/admin/all בודק חברות אמיתית; שינויים נבדקים בידי אדם כברירת מחדל. /bot2botskipreview רק יוצר. /silentactions דורש הסכמה ויומן מורשה. runs/saved לא מוגדרים מחזירים הסבר.
gg-help-family-cleanup = <b>ניקוי</b> · /cleancommand admin/user/other ו־/keepcommand בוחרים פקודות. /cleanmsg action/filter/note ו־/keepmsg רק הודעות שנשלחו באמת מהבוט הזה; קבלות ומשימות חמש דקות מונעות ניחוש מזהים. /cleanservice ו־/nocleanservice:join/leave/other/photo/pin/title/videochat. עיבוד פונקציונלי ותשלומים תקפים לפני ניקוי.
gg-help-family-topics = <b>נושאים</b> · /newtopic שם, /renametopic שם, /closetopic, /reopentopic פועלים בנושא הנוכחי האמיתי. /deletetopic דורש אישור יוצר; /setactiontopic בוחר יעד באותה קבוצה. נדרשים פורום Telegram ו־manage-topics. נושאים חסרים/לא נתמכים מחזירים שגיאות אמיתיות.
gg-help-family-utilities = <b>כלים</b> · /echo ו־/say שולחים תוכן ישיר או מתוך תשובה דרך מציג משותף מוגבל. /broadcast רק מפעיל מוגדר או בעלים אמיתי של מופע בת; רק קבוצות מוגדרות של הבוט הזה. תוצאות לכל יעד שומרות מסירה חלקית/לא ודאית; מצב וביטול אינם חוזרים על קבצים שנמסרו בהצלחה.
gg-help-family-federations = <b>פדרציות</b> · /newfed שם יוצר UUID בבוט הזה. פקודות פרטיות משתמשות בפדרציה שבבעלותכם ללא קשר לחיבורים; קריאת UUID אינה נותנת תפקיד. /fedpromote ו־/feddemote מנהלים מנהלים; /feddemoteme עוזב תפקיד. /joinfed UUID ו־/leavefed דורשים יוצר קבוצה נוכחי. מחיקה אינה מסירה חסימות Telegram. /fban userID סיבה ו־/unfban userID דורשים בעלים/מנהל פדרציה; /fedreason, /fednotif, /setfedlog בעלים. /quietfed מסתיר רק הסברי בדיקת כניסה והודעות. /subfed UUID מכוון, מוגבל וללא מחזורים. /fedstat [userID], /fbanstat UUID מציגים מקורות/מצב. /fbanlist csv/minicsv/json רק בעלים עם מרווח משותף של 30 דקות; /importfbans משיב ל־CSV מוגבל או JSON אמיתי לפי שורה ותומך במפורש במערך JSON של הבוט. נבדקים רק משתמשים שנצפו; אין טענה לרשימת חברים מלאה.
gg-help-family-portability = <b>קבצים ופרטיות</b> · /export all או מודולים דורש מנהל; /import ו־/reset יוצר אנושי נוכחי עם אישור אישי חד־פעמי לחמש דקות. מרווח מקומי חמש דקות; JSON עצמי עם גרסה, לכל היותר 2MiB ומגבלות תוכן מוגדרות. מודולים:moderation protections captcha flood raid night locks blocklists rules notes filters greetings policy language destinations extensions. מודולים שלא נבחרו נשארים. אמון, אימותים/משימות שהונפקו, מנויים, תפקידים וחסימות פעילות אינם מיובאים. /privacy policy/data/delete רק בצ׳אט הפרטי שלכם עם דפים ושמירת אבטחה מינימלית. אין מתאם מאומת לייצוא Rose מלא.
gg-help-family-discovery = <b>עזרה</b> · /help מציג תחומים; /help פקודה מחפש שמות/חלופות; /help תחום 2 ממשיך. /button עוזר בסימון כפתורים. כל מדריך מתאר הקשר, הרשאות, ברירות מחדל ומגבלות. /settings פותח את לוח הקבוצה האישי.
gg-data-error-cache_pending = נתוני SQL אופציונליים הוסרו. ניקוי המטמון שאינו זמין הוכנס לתור; נתוני אבטחה פעילים נשארים.
