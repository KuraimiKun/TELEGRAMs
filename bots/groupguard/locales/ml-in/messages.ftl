gg-fed-error-authority = നിലവിലെ ഉടമയോ യോജിച്ച ഫെഡറേഷൻ പങ്കോ വേണം. ഗ്രൂപ്പ് അഡ്മിൻ അനുമതി ഫെഡറേഷൻ അനുമതി നൽകില്ല.
gg-fed-error-private = ഈ ബോട്ടുമായുള്ള നിങ്ങളുടെ സ്വകാര്യ ചാറ്റിൽ കമാൻഡ് ഉപയോഗിക്കുക.
gg-fed-error-group = യഥാർത്ഥ ഗ്രൂപ്പിൽ ഉപയോഗിക്കുക. സ്വകാര്യ ബന്ധം ഫെഡറേഷൻ ഗ്രൂപ്പ് തിരഞ്ഞെടുക്കില്ല.
gg-fed-error-owned = ഈ ബോട്ടിൽ ഇതിനകം ഒരു ഫെഡറേഷൻ സ്വന്തമാണ്. സ്വകാര്യമായി /fedinfo, /renamefed, /delfed ഉപയോഗിക്കുക.
gg-fed-error-name = ഒഴിഞ്ഞിട്ടില്ലാത്ത, നിയന്ത്രണ അക്ഷരങ്ങളില്ലാത്ത പേര് നൽകുക; പരമാവധി64അക്ഷരം.
gg-fed-error-id = ഈ ബോട്ടിലെ സാധുവായ ഫെഡറേഷൻ UUID നൽകുക. Rose ID നമ്മുടെ വേറിട്ട സേവനവുമായി ബന്ധിപ്പിക്കില്ല.
gg-fed-error-missing = ഈ ബോട്ടിൽ/സന്ദർഭത്തിൽ ഫെഡറേഷൻ കണ്ടെത്തിയില്ല.
gg-fed-error-creator = നിലവിലെ Telegram ഗ്രൂപ്പ് സ്രഷ്ടാവിന് മാത്രം ഗ്രൂപ്പ് ചേർക്കാനോ വിട്ടുപോകാനോ കഴിയും.
gg-fed-error-target = പോസിറ്റീവ് മനുഷ്യ ID, മനുഷ്യനുള്ള മറുപടി, ഇപ്പോൾ പരിശോധിച്ച പേര് നൽകുക. ഉടമയുടെ പങ്ക് നീക്കാനാവില്ല.
gg-fed-error-value = ഫെഡറേഷൻ ആർഗ്യുമെന്റ് അസാധുവാണ്. നയത്തിന് on/off, ആവശ്യമായിടത്ത് സാധുവായ ID.
gg-fed-error-stale = സ്ഥിരീകരണം കാലഹരണപ്പെട്ടു/ഉപയോഗിച്ചു അല്ലെങ്കിൽ ഫെഡറേഷൻ/ഉടമ/ലക്ഷ്യം മാറി. പുതിയതു ആവശ്യപ്പെടുക.
gg-fed-error-destination = ഉടമ ലക്ഷ്യത്തിലെ നിലവിലെ അഡ്മിനും ബോട്ടിന് പ്രസിദ്ധീകരണ അനുമതിയും വേണം. ചാനലിന് post_messages.
gg-fed-error-delivery = വ്യക്തിഗത സ്ഥിരീകരണം അയയ്ക്കാനോ ബന്ധിപ്പിക്കാനോ കഴിഞ്ഞില്ല. സ്വകാര്യ ചാറ്റ് തുറന്ന് വീണ്ടും ശ്രമിക്കുക.
gg-fed-event = ഫെഡറേഷൻ സംഭവം:
    സംഭവം: { $event }
    ID: { $id }
    പേര്: { $name }
    അംഗം: { $user }
gg-fed-event-rename = പേര് മാറ്റി
gg-fed-event-delete = നീക്കി; Telegram നിരോധനങ്ങൾ തുടരും
gg-fed-event-promote = അഡ്മിൻ ചേർത്തു
gg-fed-event-demote = അഡ്മിൻ നീക്കി
gg-fed-event-self-remove = അഡ്മിൻ പങ്ക് വിട്ടു
gg-fed-event-reason = കാരണം നയം മാറ്റി
gg-fed-event-notif = ഉടമ അറിയിപ്പ് മാറ്റി
gg-fed-event-log = ലോഗ് ലക്ഷ്യം മാറ്റി
gg-fed-event-unlog = ലോഗ് ലക്ഷ്യം നീക്കി
gg-fed-event-ban = നിരോധന നയം സൂക്ഷിച്ചു; നടപ്പാക്കൽ ക്യൂവിൽ
gg-fed-event-unban = നിരോധന നയം നീക്കി; ബോട്ടിന്റെ നിയന്ത്രണങ്ങൾ വിടൽ ക്യൂവിൽ
gg-fed-event-subscribe = സബ്സ്ക്രിപ്ഷൻ ചേർത്തു; കണ്ട അംഗ പരിശോധന ക്യൂവിൽ
gg-fed-event-unsubscribe = സബ്സ്ക്രിപ്ഷൻ നീക്കി; മറ്റ് ഉറവിടങ്ങൾ തുടരും
gg-fed-ban-details = നിരോധന ലക്ഷ്യവും കാരണവും:
    കാരണം: { $reason }
    അംഗം: { $user }
gg-fed-passive = ഫെഡറേഷൻ നയം അംഗത്തെ നിരോധിക്കുന്നു. ഉറവിടവും കാരണവും താഴെ.
    ID: { $id }
    കാരണം: { $reason }
    ഉറവിടം: { $source }
    അംഗം: { $user }
gg-fed-enforce-failed = ഫെഡറേഷൻ നയം നിരോധിക്കുന്നു; നീക്കം പരാജയപ്പെട്ടു. ബോട്ട് അനുമതി പരിശോധിക്കുക. ഉറവിടവും കാരണവും താഴെ.
    ID: { $id }
    കാരണം: { $reason }
    ഉറവിടം: { $source }
    അംഗം: { $user }
gg-fed-stat = ഈ അംഗത്തിന്റെ ഫെഡറേഷൻ നിരോധനങ്ങൾ:
    { $rows }
    അംഗം: { $user }
gg-fed-stat-line = { $name } (<code>{ $id }</code>) — സജീവം: { $status }; മാറ്റം: { $date }.
gg-fed-stat-more = കൂടുതൽ ഉറവിടങ്ങളുണ്ട്. തുടരാനുള്ള കമാൻഡ് അല്ലെങ്കിൽ നിശ്ചിത ഫെഡറേഷൻ ID ഉപയോഗിക്കുക.
gg-fed-intent-saved = നയം സൂക്ഷിച്ചു; കണ്ട ലക്ഷ്യങ്ങൾ ക്യൂവിൽ. ഫലത്തിന് മുമ്പ് നിലവിലെ അനുമതിയും മറ്റു നിയന്ത്രണ ഉറവിടങ്ങളും പരിശോധിക്കും.
    അംഗം: { $user }
    പതിപ്പ്: { $version }
gg-fed-subscriptions = നേരിട്ടുള്ള ഫെഡറേഷൻ നിരോധന സബ്സ്ക്രിപ്ഷനുകൾ:
    { $rows }
gg-fed-imported = രേഖകൾ പരിശോധിച്ച് സൂക്ഷിച്ചു; സമാന പകർപ്പുകൾ ഒഴിവാക്കി. കണ്ട ലക്ഷ്യ നടപ്പാക്കൽ ക്യൂവിൽ.
    എണ്ണം: { $count }
    സമാന പകർപ്പ്: { $duplicates }
gg-fed-event-import = പരിശോധിച്ച നിരോധനങ്ങൾ ഇറക്കുമതി ചെയ്തു; നടപ്പാക്കൽ ക്യൂവിൽ
gg-fed-error-file-format = UTF-8 CSV id/reason, JSONL/NDJSON user_id അല്ലെങ്കിൽ ഈ ബോട്ടിന്റെ JSON array യ്ക്ക് മറുപടി നൽകുക. അസാധുവായ വരി എല്ലാ എഴുത്തും തടയും.
gg-fed-error-file-limit = പരമാവധി2MiB/1000രേഖ. അപൂർണ്ണമോ വലുതോ ആയ ഫയൽ നിരസിക്കും; പട്ടിക നിശ്ശബ്ദമായി മുറിക്കില്ല.
gg-fed-error-file-duplicate = ഒരേ അംഗ IDയ്ക്ക് പരസ്പരവിരുദ്ധ രേഖ. നിരോധനങ്ങൾ ഇറക്കുമതി ചെയ്തില്ല.
gg-fed-error-file-rate = ഫെഡറേഷനിലെ ഇറക്കുമതി/കയറ്റുമതി30മിനിറ്റ് ഇടവേള പങ്കിടുന്നു. പിന്നീട് ശ്രമിക്കുക.
gg-fed-error-reason = കാരണം പരമാവധി1024അക്ഷരം; പിന്തുണയ്ക്കാത്ത നിയന്ത്രണ അക്ഷരങ്ങൾ ഇല്ലാതെ.
gg-fed-error-reason_required = ഓരോ നിരോധനത്തിനും ഒഴിഞ്ഞിട്ടില്ലാത്ത കാരണം വേണം.
gg-fed-error-cycle = ഫെഡറേഷന് സ്വയം സബ്സ്ക്രൈബ് ചെയ്യാനോ ദിശയുള്ള ചക്രം സൃഷ്ടിക്കാനോ കഴിയില്ല.
gg-fed-error-graph_limit = പരിധി എത്തി:32നേരിട്ടുള്ള ലക്ഷ്യം,128എത്താവുന്ന ഫെഡറേഷൻ, ആഴം16 അല്ലെങ്കിൽ10000ബന്ധം.
gg-data-confirm = അഞ്ചുമിനിറ്റിൽ സ്ഥിരീകരിക്കുക. നിലവിലെ സ്രഷ്ടാവും ഗ്രൂപ്പ് പതിപ്പും വീണ്ടും പരിശോധിക്കും. തിരഞ്ഞെടുത്ത ഘടകങ്ങൾ മാത്രം മാറും; തിരിച്ചറിയൽ, വിശ്വാസം, സജീവ നിരോധനം തുടരും.
    SHA-256: { $digest }
    ഗ്രൂപ്പ്: { $group }
    ഘടകങ്ങൾ: { $modules }
    പ്രവർത്തനം: { $operation }
gg-data-import = ഗ്രൂപ്പ് ഘടകങ്ങൾ ഇറക്കുമതി
gg-data-reset = ഗ്രൂപ്പ് ഘടകങ്ങൾ പുനഃക്രമീകരണം
gg-data-privacy-delete = ഈ ബോട്ടിന്റെ ഐച്ഛിക വ്യക്തിഗത ഡാറ്റ നീക്കുക
gg-data-confirm-button = മാറ്റം സ്ഥിരീകരിക്കുക
gg-data-personal = സ്വന്തം സ്വകാര്യ ചാറ്റിൽ സ്ഥിരീകരണം തുറക്കുക.
gg-data-saved = തിരഞ്ഞെടുത്ത ഘടകങ്ങൾ സൂക്ഷിച്ചു.
gg-data-error-authority = ഇറക്കുമതി/പുനഃക്രമീകരണത്തിന് ഇപ്പോഴത്തെ തിരിച്ചറിയാവുന്ന സ്രഷ്ടാവ്; കയറ്റുമതിക്ക് നിലവിലെ അഡ്മിൻ വേണം.
gg-data-error-format = /export നിർമ്മിച്ച സാധുവായ പതിപ്പുള്ള Group Guard JSONയ്ക്ക് മറുപടി നൽകുക.
gg-data-error-limit = ഫയൽ വലിപ്പം/ഉള്ളടക്ക പരിധി കടന്നു.
gg-data-error-version = സ്കീമ/പതിപ്പ് പിന്തുണയ്ക്കുന്നില്ല; മാറ്റമില്ല.
gg-data-error-module = അറിയാവുന്ന ഘടകങ്ങൾ:/export all അല്ലെങ്കിൽ /export notes rules. ഇറക്കുമതി/പുനഃക്രമീകരണത്തിലും അതേ പേരുകൾ.
gg-data-error-field = ഘടക ഫീൽഡ് അസാധുവോ അപൂർണ്ണമോ. ക്രമീകരണം പ്രയോഗിച്ചില്ല.
gg-data-error-item = ഉള്ളടക്കം, ഓപ്ഷൻ, ആവർത്തന അനുമതി അസാധുവാണ്. സൂക്ഷിച്ചില്ല.
gg-data-error-media = മീഡിയ ഈ ബോട്ടിൽ അപ്ലോഡ് ചെയ്ത് getFile വഴി ലഭ്യമായിരിക്കണം. മറ്റു ബോട്ട് ഫയൽ ID പിന്തുണയ്ക്കുന്നില്ല.
gg-data-error-destination = ലോഗ്/വിഷയ ലക്ഷ്യത്തിന് നിലവിലെ അനുമതിയും ബോട്ട് കഴിവും വേണം. വിഷയ ID അതേ ഗ്രൂപ്പിൽ മാത്രം.
gg-data-error-language = /setlang വഴി ഇൻസ്റ്റാൾ ചെയ്ത ഭാഷ തിരഞ്ഞെടുക്കുക.
gg-data-error-stale = സ്ഥിരീകരണം കാലഹരണപ്പെട്ടു/മാറി/ഉപയോഗിച്ചു. വീണ്ടും തുടങ്ങുക.
gg-data-error-restore = ബോട്ടിന്റെ താൽക്കാലിക നിയന്ത്രണം സുരക്ഷിതമായി പുനഃസ്ഥാപിക്കാനാവില്ല. തെളിവ് തുടരും; ബോട്ട് അനുമതി പരിശോധിക്കുക.
gg-data-error-rate = ഗ്രൂപ്പ് ഡാറ്റ പ്രവർത്തനത്തിന് പ്രാദേശിക അഞ്ചുമിനിറ്റ് ഇടവേള. പിന്നീട് ശ്രമിക്കുക.
gg-data-error-delivery = സ്വകാര്യ സ്ഥിരീകരണം എത്തിയില്ല. ബോട്ടുമായി സ്വകാര്യ ചാറ്റ് തുറന്ന് വീണ്ടും ശ്രമിക്കുക.
gg-data-error-saved_delivery = ക്രമീകരണം സൂക്ഷിച്ചു; കമാൻഡ് നിർദ്ദേശം പുതുക്കിയില്ല. ബോട്ട് അനുമതി പരിശോധിക്കുക.
gg-privacy-policy = <b>ഈ Group Guardൽ നിങ്ങളുടെ ഡാറ്റ</b>
    /privacy data ബന്ധങ്ങൾ, കണ്ട പ്രൊഫൈൽ, മുന്നറിയിപ്പ്, അംഗീകാരം, നിയന്ത്രണ/പരിശോധന നില, ഫെഡറേഷൻ ഉടമസ്ഥത/പങ്ക്/നിരോധനം, സുരക്ഷാ ജോലി എന്നിവ കയറ്റുമതി ചെയ്യുന്നു. മറ്റുള്ളവരുടെ സ്വകാര്യ ഉള്ളടക്കം, പരിശോധന ഉത്തരം, രഹസ്യ പ്രവേശന വിവരം, അസംസ്കൃത അപ്ലോഡ് ഉൾപ്പെടില്ല. തുടരാനുള്ള കമാൻഡ് ഉപയോഗിക്കുക.
    /privacy delete ഐച്ഛിക ബന്ധചരിത്രം, കണ്ട പേര്/ഉപയോക്തൃപേര്, നിർജ്ജീവ പരിശോധന, നിങ്ങളുടെ പൂർത്തിയായ പ്രചാരണ ഉള്ളടക്കം നീക്കുന്നു. സജീവ മുന്നറിയിപ്പ്/നിയന്ത്രണം, നിരോധന പതിപ്പ്, പങ്ക്, ഉടമസ്ഥത, സേവനാവകാശം, പുനരാവർത്തന പ്രതിരോധം, അനിശ്ചിത API ജോലി എന്നിവ കുറഞ്ഞ IDകൾ നിലനിർത്തും. ഫെഡറേഷൻ വിടൽ/നീക്കൽ വ്യക്തമായ കമാൻഡുകൾ ഉപയോഗിക്കുക. പങ്കിട്ട പ്ലാറ്റ്ഫോം പ്രൊഫൈലും മറ്റു ബോട്ടുകളും നിലനിൽക്കും.
    ഓപ്പറേറ്റർ ബാക്കപ്പും ഓഡിറ്റും വേറിട്ട് കൈകാര്യം ചെയ്യുന്നു. പുറത്തെ Telegram സന്ദേശമോ ബാക്കപ്പോ നീക്കില്ല; സ്വയം നിലനിർത്തൽ കാലം ഉറപ്പുനൽകില്ല.
gg-privacy-usage = /privacy policy · /privacy data [തുടർച്ച] · /privacy delete — സ്വന്തം സ്വകാര്യ ചാറ്റിൽ മാത്രം.
gg-privacy-private = അപേക്ഷിക്കുന്ന മനുഷ്യന്റെ യഥാർത്ഥ സ്വകാര്യ ചാറ്റ് വേണം. അസാധുവായ കർസർ മറ്റുള്ളവരുടെ ഡാറ്റ നൽകില്ല.
gg-privacy-next = അടുത്ത ഡാറ്റ പേജ്:/privacy data { $cursor }
gg-privacy-deleted = ഈ ബോട്ടിന്റെ ഐച്ഛിക വ്യക്തിഗത ഡാറ്റ നീക്കി. സജീവ സുരക്ഷ, ഉടമസ്ഥത, അനിശ്ചിത ജോലി കുറഞ്ഞ ID നിലനിർത്തും; /privacy policy കാണുക.
gg-language-usage = /setlang ഗ്രൂപ്പ് ഭാഷ. സ്വകാര്യ /lang വ്യക്തിഗത പ്ലാറ്റ്ഫോം ഭാഷ. ലഭ്യമായ കോഡുകൾ താഴെ.
    ഭാഷ കോഡുകൾ: { $codes }
gg-language-saved = ഗ്രൂപ്പ് മറുപടി ഭാഷ മാറ്റി.
gg-help-index = <b>Group Guard കമാൻഡ് സഹായം</b>
    /help വിഭാഗം · /help കമാൻഡ് · /help വിഭാഗം 2. കാണിച്ച കമാൻഡുകൾ പരിശോധിച്ച /connect വഴിയും; സ്വകാര്യ മറുപടി യഥാർത്ഥ സ്വകാര്യ ചാറ്റിൽ.
    ക്രമീകരണം change_info; ശിക്ഷ restrict_members; മായ്ക്കൽ delete_messages; പിൻ pin_messages; നിയമനം promote_members; വിഷയം manage_topics. ബോട്ട് അനുമതി വേറിട്ട് പരിശോധിക്കും. ഉടമ നടപടി ഇപ്പോഴത്തെ മനുഷ്യ സ്രഷ്ടാവ് മാത്രം. /settings വ്യക്തിഗത ഗ്രൂപ്പ് പാനൽ.
gg-help-search = <b>പൊരുത്തമുള്ള കമാൻഡുകൾ</b>
    തിരച്ചിൽ: { $query }
gg-help-connected = ഗ്രൂപ്പ് അല്ലെങ്കിൽ പരിശോധിച്ച ബന്ധം; പരിധിയുള്ള അനുമതി
gg-help-group-only = യഥാർത്ഥ ഗ്രൂപ്പ് സന്ദേശം വേണം
gg-help-unsupported = പട്ടിക നാമം നിലനിർത്തി; നിർവചിക്കാത്ത നടപടി വിശദീകരണം നൽകും
gg-help-next = അടുത്ത പേജ്
gg-help-previous = മുൻ പേജ്
gg-help-family-title-moderation = അംഗ നിയന്ത്രണവും അംഗീകാരവും
gg-help-family-title-messages = സന്ദേശം മായ്ക്കലും പിനും
gg-help-family-title-logging = അനുമതിയുള്ള ലോഗുകൾ
gg-help-family-title-settings = ഗ്രൂപ്പ് ക്രമീകരണവും ഭാഷയും
gg-help-family-title-content = കുറിപ്പ്, ഫിൽട്ടർ, നിയമം, സ്വാഗതം
gg-help-family-title-captcha = പുതിയ അംഗ പരിശോധന
gg-help-family-title-locks = ഉള്ളടക്ക നിയന്ത്രണവും ഒഴിവും
gg-help-family-title-blocklists = നിരോധിച്ച പൊരുത്തങ്ങളും നടപടിയും
gg-help-family-title-antispam = സന്ദേശപ്രളയ/കൂട്ടപ്രവേശന സംരക്ഷണം
gg-help-family-title-connections = സ്വകാര്യ ഗ്രൂപ്പ് ബന്ധങ്ങൾ
gg-help-family-title-identity = അംഗ/ചാറ്റ് വിവരം
gg-help-family-title-policy = കമാൻഡ്, ബോട്ട് നയം
gg-help-family-title-cleanup = കമാൻഡ്, ബോട്ട്, സേവന ശുചീകരണം
gg-help-family-title-topics = ഫോറം വിഷയങ്ങൾ
gg-help-family-title-utilities = ഉള്ളടക്കവും ഓപ്പറേറ്റർ പ്രചാരണവും
gg-help-family-title-federations = ഫെഡറേഷൻ പങ്ക്, നിരോധനം, സബ്സ്ക്രിപ്ഷൻ
gg-help-family-title-portability = ഗ്രൂപ്പ് ഫയലും വ്യക്തിഗത ഡാറ്റയും
gg-help-family-title-discovery = സഹായവും ഉള്ളടക്ക എഡിറ്ററും
gg-help-family-moderation = മറുപടി, ID, പരിശോധിച്ച @പേര്. /ban 20 കാരണം, /tban 20 60s കാരണം, /mute 20, /tmute 20 2h കാരണം; താൽക്കാലികം60s–365d. /kickme സ്വയം മാത്രം. d മറുപടി മായ്ക്കും; s കമാൻഡ്/മറുപടി മായ്ക്കും, delete അനുമതി വേണം. അഡ്മിൻ സംരക്ഷിതം. /setwarnlimit 3, /setwarnmode ban, /setwarntime 1d; പുതിയ ഗ്രൂപ്പ്3മുന്നറിയിപ്പ്, പഴയ ക്രമീകരണം തുടരും. /approve സാധാരണ ഉള്ളടക്കം/പ്രളയം മാത്രം, fed/CAS/raid/മാനുവൽ അല്ല. /promote പങ്കിട്ട അനുമതി പരിധി. പൂർണ്ണ പുനഃക്രമീകരണം സ്രഷ്ടാവിന്.
gg-help-family-messages = /del യഥാർത്ഥ ഗ്രൂപ്പ് മറുപടി വേണം. /purge അവിടെ തുടങ്ങും; /purgefrom, /purgeto അതിരുകൾ. നിശ്ചിത പരിധിയും Telegram നിയമവും ബാധകം; ബാച്ച് അംഗീകാരം കൃത്യമായ മായ്ച്ച എണ്ണം അല്ല. /pin [loud], /permapin, /unpin, /unpinall pin അനുമതി; മുഴുവൻ നീക്കാൻ സ്രഷ്ടാവ്. /antichannelpin, /cleanlinked ബന്ധിച്ച ചാനലിന്റെ സ്വയം സന്ദേശങ്ങൾ.
gg-help-family-logging = /setlog -100… ലക്ഷ്യത്തിൽ നിലവിലെ അഡ്മിനും ബോട്ടിന് പ്രസിദ്ധീകരണ അനുമതിയും വേണം. കൈമാറിയ സജ്ജീകരണം യഥാർത്ഥ ഉറവിടവുമായി പൊരുത്തപ്പെടണം. /logcategories settings/admin/user/automated/reports/other; /log, /nolog തിരഞ്ഞെടുപ്പ്. അയയ്ക്കൽ പരാജയം വ്യക്തമാകും; നടപടി വിജയത്തിന്റെ തെളിവല്ല.
gg-help-family-settings = /settings കാലഹരണപ്പെടുന്ന വ്യക്തിഗത പാനൽ, പുതിയ change_info പരിശോധന. /setlang കോഡ് ഗ്രൂപ്പ് ഭാഷ; സ്വകാര്യ /lang സ്വന്തം ഭാഷ. /night 23 7 +3 രാത്രിയിൽ അടയ്ക്കും; /night off ഇപ്പോഴും പൊരുത്തമുള്ള ബോട്ടിന്റെ അനുമതി മാത്രം പുനഃസ്ഥാപിക്കും. പുറത്തെ മാറ്റത്തിന് മുൻഗണന.
gg-help-family-content = /save വാക്ക് ഉള്ളടക്കം അല്ലെങ്കിൽ മീഡിയ മറുപടി; /get വാക്ക്, #വാക്ക്, /notes. പുതിയ പേര് ഒറ്റവാക്ക്; പഴയ വിശാല പേര് നിലനിർത്തും. /filter "വാക്യം" ഉള്ളടക്കം, /filterprefix, /filterexact; /stop കൃത്യ കീ. /clearall, /stopall സ്രഷ്ടാവ് സ്ഥിരീകരണം. Rose രൂപം, ലിങ്ക്, ഉദ്ധരണി, random %%%. ഫീൽഡുകൾ:{ "{" }first{ "}" }, { "{" }last{ "}" }, { "{" }fullname{ "}" }, { "{" }username{ "}" }, { "{" }mention{ "}" }, { "{" }id{ "}" }, { "{" }chatname{ "}" }, { "{" }count{ "}" }. /button URL/കുറിപ്പ്/നിയമം. ഓപ്ഷൻ preview/nonotif/protect/mediaspoiler; കുറിപ്പ് admin/private/noprivate/repeat; ഫിൽട്ടർ user/allow_bot/replytag/command. /save വാക്ക് നമസ്കാരം { "{" }repeat 5m{ "}" } പൊതുവായ ഉള്ളടക്കവും നിലവിലെ രചയിതൃ അനുമതിയും മാത്രം. മീഡിയ സ്വന്തം ബോട്ടിൽ.
gg-help-family-captcha = /captcha on/off, /captchamode off/button/math/text/text2, /setcaptchatext, /captcharules on, /captchakick on/off; /captchakicktime, /captchamutetime പരിധിയുള്ള സമയം. നൽകിയ പരിശോധനയ്ക്ക് തലമുറ/സമയപരിധി. പ്രവേശന അപേക്ഷ invite-users; എഴുത്ത് നിയന്ത്രണം restrict-members. വ്യക്തിഗത ഒറ്റത്തവണ ഉത്തരം; ഫെഡറേഷൻ നിരോധനം ആദ്യം.
gg-help-family-locks = /lock links [നടപടി], /unlock തരം; /locktypes യഥാർത്ഥ തരങ്ങൾ, /locks നില. /lockwarns മുന്നറിയിപ്പ്. /allowlist domain/path, കൃത്യ ക്ഷണം, @chat അല്ലെങ്കിൽ stickerpack:/forward:/inline:/channel:/chat:/bot:/command:. തെറ്റ് നിരസിക്കും. പൊരുത്തമുള്ള ഉള്ളടക്കത്തിന് മാത്രം ഒഴിവ്. നിശ്ശബ്ദ ഓട്ടോമേഷൻ സ്രഷ്ടാവും അംഗീകൃത ലോഗും.
gg-help-family-blocklists = /addblocklist "വാക്യം" text/prefix/exact, വ്യക്തമായ തിരിച്ചറിയൽ, ഐച്ഛിക കാരണം/നടപടി. /rmblocklist തിരഞ്ഞെടുത്ത കൃത്യ കീ. /blocklistmode nothing/warn/kick/ban/tban/mute/tmute; താൽക്കാലികത്തിന് കാലം. /blocklistdelete വേറെയാണ്. പാറ്റേൺ സങ്കീർണ്ണത പരിധി; അസാധുവോ അധികമോ ആയ രേഖ നിരസിക്കും.
gg-help-family-antispam = /setflood എണ്ണം തുടർച്ച; /setfloodtimer എണ്ണം കാലം സമയജാലകം; /setfloodmode ശിക്ഷ/കാലം; /clearflood നിര ശുചീകരണം. പഴയ ക്രമീകരണം തുടരും. /flood, /antiflood നയം; അപരനാമം പ്രാദേശിക തീരുമാനം. /antiraid on/off/duration, /raidtime, /raidactiontime, /autoantiraid കാലവും ശിക്ഷയും വേറിട്ട്. അംഗീകാരം/CAPTCHAയ്ക്ക് മുമ്പ്; തലമുറ കാലഹരണം പുനരാരംഭത്തിലും.
gg-help-family-connections = /connect groupID അല്ലെങ്കിൽ വ്യക്തിഗത ലിങ്ക്; നിങ്ങളുടെ/ബോട്ടിന്റെ അംഗത്വം പരിശോധിക്കും. മാറ്റത്തിന് ഇപ്പോഴത്തെ കൃത്യ അനുമതി വേണം. /connection തിരഞ്ഞെടുപ്പ്; /disconnect നീക്കം; /connect ചരിത്രവും തുടർച്ചയും. ബന്ധം ഫെഡറേഷൻ ഉടമ/ഓപ്പറേറ്റർ അനുമതി നൽകില്ല.
gg-help-family-identity = /id യഥാർത്ഥ അംഗ/ചാറ്റ്/ഉറവിട ID; /info നിലവിലെ ലക്ഷ്യം. മറുപടി/@പേര് സ്വന്തം ബോട്ടിന്റെ പുതിയ തെളിവ് വേണം. അജ്ഞാത ഗ്രൂപ്പ് സന്ദേശം മനുഷ്യനെ തിരിച്ചറിയില്ല; മനുഷ്യ ID സൃഷ്ടിക്കില്ല.
gg-help-family-policy = /disable കമാൻഡ്, /enable കമാൻഡ്, /disabled, /disableable യഥാർത്ഥ/അപരനാമം. /disableadmin അഡ്മിൻ ഒഴിവ്; /disabledel മായ്ക്കൽ. വീണ്ടെടുക്കൽ കമാൻഡ് ലഭ്യമാണ്. /bot2bot off/admin/all യഥാർത്ഥ അംഗത്വം; മനുഷ്യ പരിശോധന അടിസ്ഥാനമായി. /bot2botskipreview സ്രഷ്ടാവിന് മാത്രം. /silentactions സമ്മതവും അംഗീകൃത ലോഗും. runs/saved നിർവചിച്ചിട്ടില്ല; വിശദീകരണം.
gg-help-family-cleanup = /cleancommand admin/user/other, /keepcommand കമാൻഡ് തിരഞ്ഞെടുപ്പ്. /cleanmsg action/filter/note, /keepmsg സ്വന്തം ബോട്ട് യഥാർത്ഥത്തിൽ അയച്ചവ മാത്രം; രസീതും5മിനിറ്റ് ജോലിയും, ഊഹിച്ച ID അല്ല. /cleanservice, /nocleanservice join/leave/other/photo/pin/title/videochat. സാധുവായ സേവനം/പണം ആദ്യം പ്രോസസ് ചെയ്യും.
gg-help-family-topics = /newtopic പേര്, /renametopic പേര്, /closetopic, /reopentopic യഥാർത്ഥ ഇപ്പോഴത്തെ വിഷയം. /deletetopic സ്രഷ്ടാവ് സ്ഥിരീകരണം; /setactiontopic അതേ ഗ്രൂപ്പ്. Telegram ഫോറവും manage-topics വേണം. ലഭ്യമല്ലാത്ത/പിന്തുണയ്ക്കാത്ത വിഷയത്തിന് യഥാർത്ഥ പിശക്.
gg-help-family-utilities = /echo, /say നേരിട്ടോ മറുപടിയായോ ഉള്ളടക്കം പരിധിയുള്ള റെൻഡറിലൂടെ. /broadcast നിശ്ചിത ഓപ്പറേറ്റർ/യഥാർത്ഥ ചൈൽഡ് ഉടമ മാത്രം; സ്വന്തം ബോട്ടിന്റെ നിശ്ചിത ഗ്രൂപ്പ് മാത്രം. ഓരോ ലക്ഷ്യത്തിനും ഭാഗിക/അനിശ്ചിത ഫലം; നില/റദ്ദാക്കൽ വിജയിച്ച് അയച്ചത് ആവർത്തിക്കില്ല.
gg-help-family-federations = /newfed പേര് സ്വന്തം UUID. സ്വകാര്യമായി നിങ്ങളുടെ ഉടമസ്ഥ ഫെഡറേഷൻ, ബന്ധം ബാധകമല്ല; UUID വായന പങ്ക് നൽകില്ല. /fedpromote, /feddemote പങ്ക്; /feddemoteme സ്വയം. /joinfed UUID, /leavefed ഗ്രൂപ്പ് സ്രഷ്ടാവ്. നീക്കം Telegram നിരോധനം നീക്കില്ല. /fban userID കാരണം, /unfban userID ഉടമ/ഫെഡ് അഡ്മിൻ; /fedreason, /fednotif, /setfedlog ഉടമ. /quietfed വിശദീകരണം മാത്രം. /subfed UUID പരിധിയുള്ള ദിശ, ചക്രമില്ല. /fedstat [userID], /fbanstat UUID ഉറവിടം/നില. /fbanlist csv/minicsv/json ഉടമ30മിനിറ്റ് പങ്കിട്ട ഇടവേള; /importfbans പരിധിയുള്ള CSV/യഥാർത്ഥ JSONL/സ്വന്തം JSON array. കണ്ട അംഗങ്ങൾ മാത്രം; പൂർണ്ണ പട്ടിക അവകാശമില്ല.
gg-help-family-portability = /export all അല്ലെങ്കിൽ ഘടകം അഡ്മിന്; /import, /reset ഇപ്പോഴത്തെ മനുഷ്യ സ്രഷ്ടാവും ഒറ്റത്തവണ5മിനിറ്റ് വ്യക്തിഗത സ്ഥിരീകരണവും. പ്രാദേശിക5മിനിറ്റ് ഇടവേള. സ്വന്തം പതിപ്പുള്ള JSON2MiB, ഉള്ളടക്ക പരിധി. ഘടകങ്ങൾ:moderation protections captcha flood raid night locks blocklists rules notes filters greetings policy language destinations extensions. തിരഞ്ഞെടുക്കാത്തത് തുടരും. വിശ്വാസം, നൽകിയ പരിശോധന/ജോലി, സേവനാവകാശം, പങ്ക്, സജീവ നിരോധനം ഇറക്കുമതി ഇല്ല. /privacy policy/data/delete സ്വന്തം സ്വകാര്യ ചാറ്റ്; പേജും കുറഞ്ഞ സുരക്ഷാ സംരക്ഷണവും. പൂർണ്ണ Rose കയറ്റുമതി അഡാപ്റ്റർ പരിശോധിച്ചിട്ടില്ല.
gg-help-family-discovery = /help വിഭാഗങ്ങൾ; /help കമാൻഡ് പേര്/അപരനാമം; /help വിഭാഗം 2 തുടർച്ച. /button ബട്ടൺ അടയാള സഹായം. ഓരോ സഹായത്തിനും സന്ദർഭം, അനുമതി, അടിസ്ഥാന നയം, പരിധി. /settings വ്യക്തിഗത ഗ്രൂപ്പ് പാനൽ.
gg-data-error-cache_pending = ഐച്ഛിക SQL ഡാറ്റ നീക്കി. ലഭ്യമല്ലാത്ത കാഷെ ശുചീകരണം ക്യൂവിൽ; സജീവ സുരക്ഷാ ഡാറ്റ തുടരും.
