# ==============================================================================
# Telegram Multi-Bot Platform — environment configuration
#
# Platform-wide settings use plain names. Per-bot settings are prefixed with the bot slug in
# UPPER CASE, e.g. SOCIALDOWNLOAD_TOKEN. Values marked REQUIRED have no safe default.
# ==============================================================================

# --- Platform ------------------------------------------------------------------
# Users with admin rights in every bot plus the cross-bot /platform dashboard (comma-separated IDs).
SUPER_ADMIN_IDS=123456789
# Standalone bots to run (comma-separated slugs). Empty = all standalone packages under bots/.
# Available: socialdownload, notes, anonymous, groupguard, factory, cvbot, doctools, channelmanager.
# feedback and custombot are factory-only templates and do not need platform tokens.
ENABLED_BOTS=socialdownload,notes,anonymous,groupguard,factory,cvbot,doctools
# Optional Channel Manager foundation: add channelmanager above and enable its worker/profile.
CHANNELMANAGER_TOKEN=
CHANNELMANAGER_ADMIN_IDS=
# Fallback language for users whose Telegram language has no translation (en, ar, ru, es).
DEFAULT_LANG=en
# UTC hour at which the daily stats report is posted to each bot's <SLUG>_LOG_CHANNEL_ID.
DAILY_REPORT_HOUR_UTC=6

# --- Infrastructure (docker-compose builds DATABASE_URL / REDIS_URL from these) ----
POSTGRES_USER=bot
POSTGRES_PASSWORD=                     # REQUIRED — long random string
POSTGRES_DB=bot
REDIS_PASSWORD=                      # REQUIRED — long random string
# Outside docker-compose (local dev), set the URLs directly instead:
# DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_URL=                     # optional separate LRU Redis for caches
# Connections per process (gateway, scheduler and each worker replica each open a pool).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Local Telegram Bot API server (2 GB uploads). Credentials from https://my.telegram.org
TELEGRAM_API_ID=                       # REQUIRED for docker-compose
TELEGRAM_API_HASH=                     # REQUIRED for docker-compose
# Pin tested image tags in production:
# Required before Compose startup. Use a digest verified by your container/live canary.
# TELEGRAM_BOT_API_IMAGE=aiogram/telegram-bot-api@sha256:<tested-digest>
# POT_PROVIDER_IMAGE=brainicism/bgutil-ytdlp-pot-provider:<tag>

# --- Public endpoint, TLS, webhooks -------------------------------------------------
# Public hostname served by nginx with a Let's Encrypt certificate.
DOMAIN=bots.example.com                # REQUIRED for docker-compose
LETSENCRYPT_EMAIL=admin@example.com
# Webhook base URL; each bot receives updates at <WEBHOOK_BASE_URL>/webhook/<slug>.
# Leave empty for long polling (local development).
WEBHOOK_BASE_URL=https://bots.example.com
WEBHOOK_MAX_CONNECTIONS=40
WEB_HOST=0.0.0.0
WEB_PORT=8080
# HMAC secret shared by the app and nginx for expiring /dl/ download links.
DIRECT_LINK_SECRET=                    # REQUIRED for direct links — long random string

# --- Logging & monitoring ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
ENVIRONMENT=production
RELEASE=
# Prometheus endpoint of the scheduler / bot processes (the gateway serves /metrics on WEB_PORT).
METRICS_PORT=9100

# --- AI (CV analyzer, study tools, anonymous hints, anti-spam) -----------------------------
# Provider: anthropic (default, Claude) or openai. Bots hide AI features when no key is set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model ids; empty = provider default (Claude Opus 5.5 + Claude Haiku 5.5 for quick tasks).
AI_MODEL=
AI_FAST_MODEL=
# Platform-wide token cap per UTC day across all bots (0 = unlimited). Protects your bill.
AI_DAILY_TOKEN_BUDGET=2000000
AI_CONCURRENCY=8

# --- Bot factory (users create their own bots) ----------------------------------------
# REQUIRED to run the factory: encrypts user bot tokens at rest and signs their webhooks.
# Generate with: openssl rand -hex 32. Retain it with backups; existing tokens need re-encryption
# before changing it. See docs/OPERATIONS.md for factory key rotation.
FACTORY_SECRET_KEY=
# Development (polling) only: max user bots polled by `python -m core dev`.
FACTORY_DEV_POLLING_MAX=20

# --- Backups -------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=3

# ==============================================================================
# Per-bot settings: <SLUG>_*
# Every bot understands: TOKEN (REQUIRED), ADMIN_IDS, WEBHOOK_SECRET, LOG_CHANNEL_ID, SUPPORT_USERNAME
# ==============================================================================

# --- SocialDownload (slug: socialdownload) ---------------------------------------------
SOCIALDOWNLOAD_TOKEN=                  # REQUIRED — from @BotFather
SOCIALDOWNLOAD_ADMIN_IDS=123456789
# Optional: A-Z a-z 0-9 _ - only. Derived from the token when empty.
SOCIALDOWNLOAD_WEBHOOK_SECRET=
# Channel/chat ID for purchase notifications and the daily report (e.g. -1001234567890).
SOCIALDOWNLOAD_LOG_CHANNEL_ID=
# Shown by /support (without @).
SOCIALDOWNLOAD_SUPPORT_USERNAME=

# Parallel downloads per worker replica, and number of worker replicas.
SOCIALDOWNLOAD_WORKER_CONCURRENCY=4
SOCIALDOWNLOAD_WORKER_REPLICAS=2
# Rotating HTTP/SOCKS5 proxies (comma-separated).
SOCIALDOWNLOAD_PROXIES=
# YouTube Proof-of-Origin token provider (set automatically by docker-compose).
SOCIALDOWNLOAD_POT_PROVIDER_URL=
# Public base of direct links for files above the Telegram limit (VIP only).
SOCIALDOWNLOAD_DIRECT_LINK_BASE_URL=https://bots.example.com/dl/socialdownload
SOCIALDOWNLOAD_DIRECT_LINK_TTL_SECONDS=3600
SOCIALDOWNLOAD_CACHE_TTL_DAYS=30

# --- Notes & Reminders (slug: notes) — the second example bot -------------------------
# Add "notes" to ENABLED_BOTS to run it.
NOTES_TOKEN=
NOTES_ADMIN_IDS=123456789
NOTES_LOG_CHANNEL_ID=

# --- Anonymous Inbox (slug: anonymous) — NGL-style anonymous messages ------------------
# Also a bot factory template. Enable inline mode in @BotFather for "Send to a chat".
ANONYMOUS_TOKEN=
ANONYMOUS_ADMIN_IDS=123456789
# Reports go here (else to the admins).
ANONYMOUS_LOG_CHANNEL_ID=

# --- Group Guard (slug: groupguard) — group moderation & anti-spam --------------------
# Also a bot factory template. In @BotFather disable "Group Privacy" (or make the bot admin in groups).
GROUPGUARD_TOKEN=
GROUPGUARD_ADMIN_IDS=123456789
GROUPGUARD_LOG_CHANNEL_ID=

# --- Bot Factory (slug: factory) — users launch their own bots from templates -----------
# Requires FACTORY_SECRET_KEY (above). Templates: anonymous, feedback, groupguard, custom.
FACTORY_TOKEN=
FACTORY_ADMIN_IDS=123456789
FACTORY_LOG_CHANNEL_ID=

# --- CV Analyzer (slug: cvbot) ---------------------------------------------------------
# Requires a configured AI provider/key for analysis. OCR fallback also needs Tesseract (eng+ara).
CVBOT_TOKEN=
CVBOT_ADMIN_IDS=123456789
CVBOT_WEBHOOK_SECRET=
CVBOT_LOG_CHANNEL_ID=
CVBOT_SUPPORT_USERNAME=
# Free daily analyses, file/page limits and Pro review Stars price are live /admin settings.

# --- Student Document Tools (slug: doctools) --------------------------------------------
# Enable inline mode in @BotFather for citations; group /cite and /count are supported.
DOCTOOLS_TOKEN=
DOCTOOLS_ADMIN_IDS=123456789
DOCTOOLS_WEBHOOK_SECRET=
DOCTOOLS_LOG_CHANNEL_ID=
DOCTOOLS_SUPPORT_USERNAME=
# Each dedicated worker handles this many document jobs concurrently.
DOCTOOLS_WORKER_CONCURRENCY=2
DOCTOOLS_JOB_TIMEOUT_SECONDS=300
DOCTOOLS_OCR_TIMEOUT_SECONDS=45
# Executable name or path; the Docker runtime includes eng and ara language data.
DOCTOOLS_TESSERACT_COMMAND=tesseract
# Basket size/page caps, AI quotas and free/VIP limits are live /admin settings.
